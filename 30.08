In den ersten 2 Lektionen c# habe ich bereits ein Auto-Spiel mit c# programmiert, welches ich schon lange vorher programmiert habe. 

In der restlichen Zeit habe ich eine Software erstellt, die 4-stellige Passwörter wieder mit c# öffnet. 


using System;

class Program
{
    static void Main()
    {
        // Set the correct password
        string correctPassword = "5555"; // Example of the correct password
        
        // Test all combinations from 0000 to 9999
        for (int i = 0; i <= 9999; i++)
        {
            // Format the password attempt as a 4-digit string (e.g., 0001, 0234)
            string passwordAttempt = i.ToString("D4");
            Console.WriteLine("Attempt: " + passwordAttempt);

            // Check if the password is correct
            if (CheckPassword(passwordAttempt, correctPassword))
            {
                Console.WriteLine("Correct password found: " + passwordAttempt);
                break; // Correct password found, exit loop
            }
        }

        Console.WriteLine("All passwords have been tested.");
    }

    // Method for password verification
    static bool CheckPassword(string passwordAttempt, string correctPassword)
    {
        // Compares the current password attempt with the correct password
        return passwordAttempt == correctPassword;
    }
}
